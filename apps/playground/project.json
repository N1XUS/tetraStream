{
  "name": "playground",
  "projectType": "application",
  "sourceRoot": "apps/playground/src",
  "implicitDependencies": ["tetra-stream"],
  "tags": ["type:app", "scope:demo"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["^package-preview"],
      "continuous": true,
      "options": {
        "command": "vite --config apps/playground/vite.config.ts --host 127.0.0.1 --port 5173"
      }
    },
    "build": {
      "executor": "@rivetjs/nx:build",
      "dependsOn": ["^package-preview"],
      "outputs": ["{workspaceRoot}/dist/apps/playground", "{projectRoot}/.wrangler/deploy"],
      "options": {
        "outputPath": "../../dist/apps/playground",
        "ssr": true,
        "prerender": true
      },
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/pack-library.mts",
        "!{projectRoot}/public/downloads/*.tgz",
        "!{projectRoot}/public/protocol/**"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "node --test apps/playground/test/*.test.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc -p apps/playground/tsconfig.json"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "wrangler deploy --config ../../dist/apps/playground/cloudflare/wrangler.json",
        "cwd": "apps/playground"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "continuous": true,
      "cache": false,
      "options": {
        "command": "wrangler dev --config ../../dist/apps/playground/cloudflare/wrangler.json --ip 127.0.0.1 --port 4173",
        "cwd": "apps/playground"
      }
    },
    "check-size": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "command": "node tools/check-homepage-budget.mts"
      }
    }
  }
}
